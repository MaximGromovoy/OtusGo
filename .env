# Переменные среды для приложения
# PostgreSQL настройки
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=exchange_service_db
POSTGRES_SSLMODE=disable

