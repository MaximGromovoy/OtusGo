{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API для управления различными типами валют",
        "title": "API Валют",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/currencies": {
            "get": {
                "security": [
                    {
                        "JWT": []
                    }
                ],
                "description": "Возвращает список всех валют или валют определенного типа",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "валюта"
                ],
                "summary": "Получение списка валют",
                "parameters": [
                    {
                        "enum": [
                            "Dollar",
                            "Euro",
                            "Ruble",
                            "Lira"
                        ],
                        "type": "string",
                        "description": "Тип валюты (опционально)",
                        "name": "type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список валют",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "data": {
                                    "type": "object"
                                },
                                "status": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Неавторизован",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/currency": {
            "post": {
                "security": [
                    {
                        "JWT": []
                    }
                ],
                "description": "Добавляет новую валюту указанного типа",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "валюта"
                ],
                "summary": "Добавление валюты",
                "parameters": [
                    {
                        "enum": [
                            "Dollar",
                            "Euro",
                            "Ruble",
                            "Lira"
                        ],
                        "type": "string",
                        "description": "Тип валюты",
                        "name": "type",
