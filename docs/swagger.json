                        "name": "type",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "ID валюты",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Новое значение валюты",
                        "name": "currency",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "value": {
